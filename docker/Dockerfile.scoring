# SCORING IMAGE BUILT ON TOP OF THE BASE IMAGE WITH THE TRAINED MODEL BAKED IN.

# THIS DOCKERFILE IS BUILT BY THE TRAIN VM AT THE END OF TRAINING, NOT FROM THE USER'S LAPTOP.

# THE BUILD CONTEXT IS THE VM DIRECTORY THAT CONTAINS THE TRAINED model/ FOLDER.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# COPY THE JUST-TRAINED PIPELINEMODEL INTO THE IMAGE AT A WELL-KNOWN PATH
COPY model /app/model

# OVERRIDE THE BASE IMAGE'S TRAINING CMD - THE SCORING IMAGE RUNS THE STREAMING CONSUMER INSTEAD
CMD ["python", "scripts/score_stream.py", "--model-dir", "/app/model"]
